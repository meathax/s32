# Real NEC V25-compatible protection subsystem for ga2 / arabfgt.
# Project builds define S32_REAL_V25 in the QSF because Quartus 17 rejects
# VERILOG_MACRO assignments scoped from a QIP. Standalone verification does
# not consume QIP files and must define S32_REAL_V25 explicitly.
set V25_QIP_DIR $::quartus(qip_path)

set_global_assignment -name QIP_FILE [file join $V25_QIP_DIR s80x86 s80x86_files.qip]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $V25_QIP_DIR s32_v25_rom_cache.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $V25_QIP_DIR s32_v25_cpu.sv]

unset V25_QIP_DIR

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mister-fpga.invalid/schema/input-event-v4.json",
  "title": "MiSTer FPGA semantic input event v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "at",
    "action"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "at": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timebase"
      ],
      "properties": {
        "timebase": {
          "enum": [
            "canonical_event",
            "video_position",
            "reset_anchor"
          ]
        },
        "domain": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "scanline": {
          "type": "integer",
          "minimum": 0
        },
        "hpos": {
          "type": "integer",
          "minimum": 0
        },
        "offset_reference_ticks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "clock_mapping_proven": {
      "type": "boolean"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "value"
      ],
      "properties": {
        "control": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "integer",
            "number",
            "boolean"
          ]
        }
      }
    }
  }
}

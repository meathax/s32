{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mister-fpga.invalid/schema/raw-trace-event-v4.json",
  "title": "MiSTer FPGA raw trace event v4",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "domain",
    "seq",
    "event",
    "phase",
    "rw",
    "address",
    "data",
    "byte_enable"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "rw": {
      "enum": [
        "R",
        "W"
      ]
    },
    "address": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(0[xX][0-9a-fA-F]+|[0-9]+)$"
        }
      ]
    },
    "data": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(0[xX][0-9a-fA-F]+|[0-9]+)$"
        }
      ]
    },
    "byte_enable": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(0[xX][0-9a-fA-F]+|[0-9]+)$"
        }
      ]
    }
  }
}

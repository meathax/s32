# Scratch/reference material used during design research — not part of the core.
# (MAME reference sources are GPL-licensed and must not be committed here.)
undefined/
scratch/
roms/
*.tmp

# Build outputs (Quartus / simulation), for later development phases
output_files/
db/
incremental_db/
simulation/
*.rpt
*.summary
*.smsg
# Isolated RAM-inference projects keep their hand-written QPF/QSF, but not
# Quartus-generated proof reports.
verif/quartus_ram_infer/*/*.rpt
verif/quartus_ram_infer/*/*.summary
*.rbf
*.qws
work/
transcript
*.wlf
/build_id.v
/jtag.cdf
verif/modelsim-regression.log
obj_dir/
rtl/pll/pll.qsys
rtl/pll/synthesis/
rtl/pll/sim/
rtl/pll/testbench/
rtl/pll/*.html
rtl/pll/*.sopcinfo
rtl/pll/*.xml

# Local verification runs and generated reference helpers
verif/modelsim_*/
!verif/modelsim_romboot/
verif/modelsim_romboot/*
!verif/modelsim_romboot/dump80.png
verif/**/msim/
verif/**/output/
verif/tools/*_tmp/
/verif/quartus_v60/s32_v60_twoport.sv

# Quartus diagnostics contain machine-specific crash/build details
cr_ie_info.json
serv_req_info.txt

# built bitstreams (distribute via Releases, not git)
releases/*.rbf
output_files/
__pycache__/
